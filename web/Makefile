.PHONY: install test test-cov lint format run build preview

# ── Setup ─────────────────────────────────────────────────────────────────────

install:
	npm install

# ── Testing ───────────────────────────────────────────────────────────────────

test:
	npm run test:unit

test-cov:
	npm run test:coverage

# ── Lint / Format ─────────────────────────────────────────────────────────────

lint:
	npm run lint

format:
	npm run format

# ── Dev server ────────────────────────────────────────────────────────────────

dev:
	npm run dev

# ── Build ─────────────────────────────────────────────────────────────────────

build:
	npm run build

preview:
	npm run preview
