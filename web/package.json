{
  "name": "brewgraph-web",
  "version": "2.0.0-migration",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:smoke": "playwright test --config=playwright.config.js",
    "test:e2e:parity": "playwright test --config=playwright.parity.config.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:modules": "vue-tsc --noEmit -p tsconfig.modules.json",
    "format": "prettier --write src/",
    "build:validators": "node scripts/build-validators.mjs",
    "check:validators": "npm run build:validators && node scripts/check-validators-reproducible.mjs",
    "check:no-bootstrap": "node scripts/check-no-bootstrap.mjs",
    "predev": "npm run build:validators",
    "prebuild": "npm run build:validators",
    "pretest:unit": "npm run build:validators",
    "pretest:coverage": "npm run build:validators",
    "pretypecheck": "npm run build:validators"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "ajv": "^8.20.0",
    "chart.js": "^4.4.8",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.1.0",
    "pinia": "^3.0.1",
    "quasar": "^2.33.1",
    "regression": "^2.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.1.36",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.0",
    "cors": "^2.8.5",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.5.1",
    "express": "^5.1.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.1",
    "multer": "^2.0.2",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.12",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.9"
  }
}
